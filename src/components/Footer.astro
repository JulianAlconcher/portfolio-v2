---
import { Github, Linkedin, Mail, ArrowUp, Heart, Code2 } from "lucide-astro";
---

<footer class="border-t border-white/10 bg-[#02050e] py-12 text-sm text-gray-400">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Brand & Copyright -->
      <div class="flex flex-col items-center md:items-start space-y-1 text-center md:text-left">
        <p class="font-bold text-white tracking-tight text-base">
          Julián Alconcher
        </p>
        <p class="text-xs text-gray-400">
          Software Engineer · Bahía Blanca, Argentina.
        </p>
        <p class="text-[11px] text-gray-500 pt-1">
          © {new Date().getFullYear()} Julián Alconcher. Todos los derechos reservados.
        </p>
      </div>

      <!-- Tech Stack Credit -->
      <div class="flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs text-gray-300 backdrop-blur-md">
        <span>Desarrollado con</span>
        <span class="font-semibold text-white">Astro</span>
        <span>&</span>
        <span class="font-semibold text-blue-400">Tailwind CSS</span>
      </div>

      <!-- Links & Back to top -->
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/JulianAlconcher"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl border border-white/10 bg-white/5 p-2 text-gray-400 hover:border-white/20 hover:bg-white/10 hover:text-white transition-all"
          aria-label="GitHub"
        >
          <Github class="h-4 w-4" />
        </a>

        <a
          href="https://www.linkedin.com/in/julian-alconcher"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl border border-white/10 bg-white/5 p-2 text-gray-400 hover:border-white/20 hover:bg-white/10 hover:text-white transition-all"
          aria-label="LinkedIn"
        >
          <Linkedin class="h-4 w-4" />
        </a>

        <a
          href="mailto:alconcherjulian@gmail.com"
          class="rounded-xl border border-white/10 bg-white/5 p-2 text-gray-400 hover:border-white/20 hover:bg-white/10 hover:text-white transition-all"
          aria-label="Email"
        >
          <Mail class="h-4 w-4" />
        </a>

        <a
          href="#"
          class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-3 py-2 text-xs font-semibold text-gray-200 hover:bg-white/20 hover:text-white transition-all"
          title="Volver arriba"
        >
          <ArrowUp class="h-3.5 w-3.5" />
          <span class="hidden sm:inline">Arriba</span>
        </a>
      </div>

    </div>
  </div>
</footer>
