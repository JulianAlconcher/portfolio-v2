---
import { skillsData } from "../data/skills";
import { Layout, Database, Cpu, Terminal, Sparkles, CheckCircle2, Wrench } from "lucide-astro";

const iconMap = {
  Layout: Layout,
  Database: Database,
  Cpu: Cpu,
  Terminal: Terminal
};
---

<section id="habilidades" class="relative py-24 sm:py-32 border-t border-white/10 bg-[#030712]/70">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 rounded-lg border border-teal-500/30 bg-teal-500/10 px-3 py-1 text-xs font-semibold text-teal-400 mb-3">
        <Wrench class="h-3.5 w-3.5" />
        <span>Stack & Conocimientos</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Tecnologías & Especialidades
      </h2>
      <p class="mt-4 text-base sm:text-lg text-gray-400">
        Herramientas, lenguajes y frameworks que empleo para diseñar arquitecturas escalables, interfaces fluidas y software confiable.
      </p>
    </div>

    <!-- Skills Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {skillsData.map((cat) => {
        const IconComponent = iconMap[cat.iconName as keyof typeof iconMap] || Terminal;
        return (
          <div class="flex flex-col justify-between rounded-2xl border border-white/10 bg-slate-900/50 p-6 backdrop-blur-md transition-all duration-300 hover:border-blue-500/40 hover:bg-slate-900/80">
            <div>
              <!-- Header -->
              <div class="flex items-center gap-3 mb-4">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-600/20 border border-blue-500/30 text-blue-400">
                  <IconComponent class="h-5 w-5" />
                </div>
                <div>
                  <h3 class="text-lg font-bold text-white">{cat.category}</h3>
                </div>
              </div>

              <p class="text-xs text-gray-400 mb-5 leading-relaxed">
                {cat.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-1.5">
                {cat.items.map((item) => (
                  <span
                    class={`inline-flex items-center gap-1 rounded-lg px-2.5 py-1 text-xs font-medium ${
                      item.highlight
                        ? "border border-blue-500/40 bg-blue-500/15 text-blue-200 font-semibold"
                        : "border border-white/10 bg-white/5 text-gray-300"
                    }`}
                  >
                    {item.highlight && <Sparkles class="h-2.5 w-2.5 text-blue-400" />}
                    {item.name}
                  </span>
                ))}
              </div>
            </div>

            <!-- Footer note -->
            <div class="pt-6 mt-6 border-t border-white/5 flex items-center gap-1.5 text-[11px] text-gray-500">
              <CheckCircle2 class="h-3.5 w-3.5 text-emerald-400" />
              <span>Producción & Proyectos reales</span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Engineering Principles Cards -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
        <h4 class="text-base font-bold text-white mb-2 flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-blue-400"></span> Arquitectura Limpia
        </h4>
        <p class="text-xs text-gray-400 leading-relaxed">
          Enfoque en bajo acoplamiento, alta cohesión y código mantenible guiado por principios SOLID y patrones de diseño.
        </p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
        <h4 class="text-base font-bold text-white mb-2 flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span> Rendimiento & Sistemas
        </h4>
        <p class="text-xs text-gray-400 leading-relaxed">
          Comprensión profunda del hardware, gestión de memoria, concurrencia, networking y optimización de carga web.
        </p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
        <h4 class="text-base font-bold text-white mb-2 flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-purple-400"></span> Orientación a Producto
        </h4>
        <p class="text-xs text-gray-400 leading-relaxed">
          De la concepción a producción: diseño de experiencia de usuario, SEO, despliegue continuo y entrega de valor real.
        </p>
      </div>
    </div>

  </div>
</section>
