---
import { skillsData } from "../data/skills";
import { Layout, Database, Cpu, Terminal, CheckCircle2 } from "lucide-astro";

const iconMap = {
  Layout: Layout,
  Database: Database,
  Cpu: Cpu,
  Terminal: Terminal
};
---

<section id="habilidades" class="relative py-20 sm:py-28 border-t border-zinc-200 dark:border-zinc-800/80 bg-zinc-50 dark:bg-[#09090b] transition-colors duration-200">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-12">
      <p class="text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">
        Stack & Herramientas
      </p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-white">
        Tecnologías Principales
      </h2>
      <p class="mt-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
        Lenguajes, frameworks y entornos con los que desarrollo software en producción.
      </p>
    </div>

    <!-- Skills Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {skillsData.map((cat) => {
        const IconComponent = iconMap[cat.iconName as keyof typeof iconMap] || Terminal;
        return (
          <div class="flex flex-col justify-between rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#111114] p-5 transition-all hover:border-zinc-400 dark:hover:border-zinc-700 shadow-xs hover:shadow-md">
            <div>
              <!-- Header -->
              <div class="flex items-center gap-3 mb-3">
                <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200">
                  <IconComponent class="h-4 w-4" />
                </div>
                <h3 class="text-sm font-bold text-zinc-900 dark:text-white">{cat.category}</h3>
              </div>

              <p class="text-xs text-zinc-600 dark:text-zinc-400 mb-4 leading-relaxed">
                {cat.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-1.5">
                {cat.items.map((item) => (
                  <span
                    class={`inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-mono ${
                      item.highlight
                        ? "border border-zinc-300 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-medium"
                        : "border border-zinc-200 dark:border-zinc-800/80 bg-zinc-50 dark:bg-zinc-900 text-zinc-700 dark:text-zinc-400"
                    }`}
                  >
                    {item.name}
                  </span>
                ))}
              </div>
            </div>

            <!-- Footer note -->
            <div class="pt-4 mt-4 border-t border-zinc-200 dark:border-zinc-800/80 flex items-center gap-1.5 text-[10px] font-mono text-zinc-500 dark:text-zinc-400">
              <CheckCircle2 class="h-3 w-3 text-emerald-500" />
              <span>Producción & Proyectos</span>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
