---
import { User, GraduationCap, MapPin, Briefcase, Award, Rocket, ShieldCheck, Download, Sparkles } from "lucide-astro";
---

<section id="sobre-mi" class="relative py-20 sm:py-28 border-t border-white/10 bg-[#030712]">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
      
      <!-- Left Column: Big Portrait Card (5 cols) -->
      <div class="lg:col-span-5 flex flex-col">
        <div class="relative w-full h-full flex flex-col overflow-hidden rounded-3xl border border-white/15 bg-slate-900/90 p-5 sm:p-6 backdrop-blur-md shadow-2xl">
          <!-- Ambient Glow -->
          <div class="absolute -top-12 -right-12 h-44 w-44 rounded-full bg-blue-500/20 blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-12 -left-12 h-44 w-44 rounded-full bg-purple-500/20 blur-3xl pointer-events-none"></div>

          <!-- Main Image - Fills available vertical space -->
          <div class="relative w-full flex-1 min-h-[380px] sm:min-h-[420px] rounded-2xl overflow-hidden border border-white/15 bg-slate-800 shadow-xl group">
            <img
              src="/profile.png"
              alt="Julián Alconcher - Ingeniero en Sistemas de Información"
              class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-linear-to-t from-slate-950 via-slate-950/25 to-transparent"></div>
            
            <!-- Bottom Text on Photo -->
            <div class="absolute bottom-4 left-4 right-4 z-10">
              <span class="inline-flex items-center gap-1 rounded-md bg-blue-600/90 px-2 py-0.5 text-[11px] font-bold text-white mb-1.5 backdrop-blur-sm">
                Ingeniero en Sistemas
              </span>
              <h3 class="text-2xl font-black text-white leading-tight">Julián Alconcher</h3>
              <div class="flex items-center gap-1.5 text-xs text-gray-300 mt-1">
                <MapPin class="h-3.5 w-3.5 text-rose-400" />
                <span>Bahía Blanca, Argentina · Remoto / Híbrido</span>
              </div>
            </div>
          </div>

          <!-- Education Badges (Compact) -->
          <div class="mt-4 space-y-2">
            <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-2.5 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <GraduationCap class="h-4 w-4 text-emerald-400" />
                <div>
                  <p class="text-xs font-bold text-white">Ingeniero en Sistemas de Información</p>
                  <p class="text-[10px] text-gray-300">Univ. Nacional del Sur (UNS) · 2019 – 2026</p>
                </div>
              </div>
              <span class="rounded bg-emerald-500/25 px-1.5 py-0.5 text-[10px] font-bold text-emerald-300">Graduado</span>
            </div>

            <div class="rounded-xl border border-blue-500/30 bg-blue-500/10 px-3.5 py-2.5 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <ShieldCheck class="h-4 w-4 text-blue-400" />
                <div>
                  <p class="text-xs font-bold text-white">Diplomatura Ciberseguridad Inteligente</p>
                  <p class="text-[10px] text-gray-300">DCIC – UNS · 2026</p>
                </div>
              </div>
              <span class="rounded bg-blue-500/25 px-1.5 py-0.5 text-[10px] font-bold text-blue-300 animate-pulse">En curso</span>
            </div>
          </div>

          <!-- Download CV Button -->
          <div class="mt-4">
            <a
              href="/CV_Julian_Alconcher.pdf"
              download="CV_Julian_Alconcher.pdf"
              class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-linear-to-r from-blue-600 to-indigo-600 py-3 px-4 text-xs font-bold text-white shadow-lg shadow-blue-600/20 hover:brightness-110 hover:shadow-blue-600/35 transition-all"
            >
              <Download class="h-4 w-4" />
              <span>Descargar CV (PDF)</span>
            </a>
          </div>

        </div>
      </div>

      <!-- Right Column: Compact & Impactful Story (7 cols) -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 rounded-lg border border-indigo-500/30 bg-indigo-500/10 px-3 py-1 text-xs font-semibold text-indigo-400">
            <User class="h-3.5 w-3.5" />
            <span>Perfil Profesional</span>
          </div>

          <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight">
            Ingeniero en Sistemas enfocado en soluciones robustas, arquitectura limpia y seguridad.
          </h2>

          <div class="space-y-3 text-sm sm:text-base text-gray-300 leading-relaxed">
            <p>
              Graduado de <strong class="text-white font-semibold">Ingeniería en Sistemas de Información</strong> en la <strong class="text-white font-semibold">Universidad Nacional del Sur (UNS)</strong> con experiencia construyendo aplicaciones web end-to-end, sistemas nativos y herramientas de automatización.
            </p>
            <p>
              Actualmente cursando la <strong class="text-white font-semibold">Diplomatura en Ciberseguridad Inteligente</strong> en el DCIC - UNS, especializándome en protección de infraestructuras, análisis de amenazas y calidad de software.
            </p>
          </div>
        </div>

        <!-- Experience & Key Focus Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4 space-y-1 backdrop-blur-sm">
            <div class="flex items-center gap-2 text-blue-400 font-bold text-xs sm:text-sm">
              <Briefcase class="h-4 w-4" />
              <span>Full-Stack & Freelance</span>
            </div>
            <p class="text-xs text-gray-400 leading-relaxed">
              Desarrollo de productos end-to-end: UX/UI, React, Next.js, Node.js, Python, bases de datos SQL/PostgreSQL y despliegues.
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4 space-y-1 backdrop-blur-sm">
            <div class="flex items-center gap-2 text-emerald-400 font-bold text-xs sm:text-sm">
              <Rocket class="h-4 w-4" />
              <span>Prácticas & Sustentabilidad</span>
            </div>
            <p class="text-xs text-gray-400 leading-relaxed">
              Frontend web & mobile con React, React Native, TypeScript, Tailwind CSS y backend PHP bajo metodología Scrum.
            </p>
          </div>
        </div>

        <!-- Certifications Compact Banner -->
        <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-4 space-y-2.5 backdrop-blur-sm">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold uppercase tracking-wider text-gray-300 flex items-center gap-1.5">
              <Award class="h-4 w-4 text-amber-400" />
              <span>Certificaciones</span>
            </h4>
            <span class="text-[10px] text-gray-400">Cisco · Anthropic · AWS · Google</span>
          </div>
          <div class="flex flex-wrap gap-1.5 text-[11px]">
            <span class="rounded-lg border border-blue-500/25 bg-blue-500/10 px-2.5 py-1 text-blue-300 font-medium">
              Cisco: Cybersecurity & Networking Basics
            </span>
            <span class="rounded-lg border border-purple-500/25 bg-purple-500/10 px-2.5 py-1 text-purple-300 font-medium">
              Anthropic: Model Context Protocol (MCP)
            </span>
            <span class="rounded-lg border border-emerald-500/25 bg-emerald-500/10 px-2.5 py-1 text-emerald-300 font-medium">
              AWS: ML Foundations & GenAI
            </span>
            <span class="rounded-lg border border-amber-500/25 bg-amber-500/10 px-2.5 py-1 text-amber-300 font-medium">
              Google: Generative AI
            </span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
