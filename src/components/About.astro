---
import { User, GraduationCap, MapPin, Briefcase, Award, Rocket, ShieldCheck, Download } from "lucide-astro";
---

<section id="sobre-mi" class="relative py-20 sm:py-28 border-t border-zinc-800/80 bg-[#09090b]">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
      
      <!-- Left Column: Big Portrait Card (5 cols) -->
      <div class="lg:col-span-5 flex flex-col">
        <div class="relative w-full h-full flex flex-col overflow-hidden rounded-2xl border border-zinc-800 bg-[#111114] p-5 backdrop-blur-md shadow-xl">

          <!-- Main Image -->
          <div class="relative w-full flex-1 min-h-[380px] sm:min-h-[420px] rounded-xl overflow-hidden border border-zinc-800 bg-zinc-900 group">
            <img
              src="/profile.png"
              alt="Julián Alconcher - Ingeniero en Sistemas de Información"
              class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-linear-to-t from-[#111114] via-[#111114]/25 to-transparent"></div>
            
            <!-- Bottom Text on Photo -->
            <div class="absolute bottom-4 left-4 right-4 z-10">
              <span class="inline-flex items-center gap-1 rounded bg-zinc-900/90 border border-zinc-700/60 px-2 py-0.5 text-[11px] font-mono text-zinc-200 mb-1.5 backdrop-blur-sm">
                Ingeniero en Sistemas
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-white leading-tight">Julián Alconcher</h3>
              <div class="flex items-center gap-1.5 text-xs text-zinc-400 mt-1">
                <MapPin class="h-3.5 w-3.5 text-rose-400" />
                <span>Bahía Blanca, Argentina · Remoto</span>
              </div>
            </div>
          </div>

          <!-- Education Badges (Clean & Compact) -->
          <div class="mt-4 space-y-2">
            <div class="rounded-xl border border-zinc-800 bg-zinc-900/70 px-3.5 py-2.5 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <GraduationCap class="h-4 w-4 text-emerald-400" />
                <div>
                  <p class="text-xs font-semibold text-white">Ingeniero en Sistemas de Información</p>
                  <p class="text-[10px] text-zinc-400 font-mono">Univ. Nacional del Sur (UNS) · 2019 – 2026</p>
                </div>
              </div>
              <span class="rounded bg-emerald-500/15 border border-emerald-500/30 px-1.5 py-0.5 text-[10px] font-mono text-emerald-300">Graduado</span>
            </div>

            <div class="rounded-xl border border-zinc-800 bg-zinc-900/70 px-3.5 py-2.5 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <ShieldCheck class="h-4 w-4 text-blue-400" />
                <div>
                  <p class="text-xs font-semibold text-white">Diplomatura Ciberseguridad Inteligente</p>
                  <p class="text-[10px] text-zinc-400 font-mono">DCIC – UNS · 2026</p>
                </div>
              </div>
              <span class="rounded bg-blue-500/15 border border-blue-500/30 px-1.5 py-0.5 text-[10px] font-mono text-blue-300 animate-pulse">En curso</span>
            </div>
          </div>

          <!-- Download CV Button -->
          <div class="mt-4">
            <a
              href="/CV_Julian_Alconcher.pdf"
              download="CV_Julian_Alconcher.pdf"
              class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-white py-2.5 px-4 text-xs font-semibold text-zinc-900 hover:bg-zinc-200 transition-colors shadow-sm"
            >
              <Download class="h-3.5 w-3.5" />
              <span>Descargar CV (PDF Actualizado)</span>
            </a>
          </div>

        </div>
      </div>

      <!-- Right Column: Compact Story (7 cols) -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <p class="text-xs font-mono uppercase tracking-wider text-zinc-400">
            Perfil Profesional
          </p>

          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white leading-tight">
            Ingeniería de software con base sólida, buenas prácticas y ciberseguridad.
          </h2>

          <div class="space-y-3 text-sm sm:text-base text-zinc-300 leading-relaxed">
            <p>
              Graduado de <strong class="text-white font-medium">Ingeniería en Sistemas de Información</strong> en la <strong class="text-white font-medium">Universidad Nacional del Sur (UNS)</strong> con experiencia en desarrollo web end-to-end, aplicaciones nativas y procesamiento de datos.
            </p>
            <p>
              Actualmente cursando la <strong class="text-white font-medium">Diplomatura en Ciberseguridad Inteligente</strong> en el DCIC - UNS, profundizando en análisis de vulnerabilidades, seguridad de la información y arquitecturas resilientes.
            </p>
          </div>
        </div>

        <!-- Experience Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div class="rounded-xl border border-zinc-800 bg-[#111114] p-4 space-y-1">
            <div class="flex items-center gap-2 text-zinc-200 font-semibold text-xs sm:text-sm">
              <Briefcase class="h-3.5 w-3.5 text-zinc-400" />
              <span>Full-Stack & Freelance</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Desarrollo de productos end-to-end: UX/UI, React, Next.js, Node.js, Python, bases de datos SQL/PostgreSQL y despliegues.
            </p>
          </div>

          <div class="rounded-xl border border-zinc-800 bg-[#111114] p-4 space-y-1">
            <div class="flex items-center gap-2 text-zinc-200 font-semibold text-xs sm:text-sm">
              <Rocket class="h-3.5 w-3.5 text-zinc-400" />
              <span>Prácticas & Sustentabilidad</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Frontend web & mobile con React, React Native, TypeScript, Tailwind CSS y backend PHP bajo metodología Scrum.
            </p>
          </div>
        </div>

        <!-- Certifications -->
        <div class="rounded-xl border border-zinc-800 bg-[#111114] p-4 space-y-2.5">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-mono uppercase tracking-wider text-zinc-400 flex items-center gap-1.5">
              <Award class="h-3.5 w-3.5 text-zinc-300" />
              <span>Certificaciones</span>
            </h4>
            <span class="text-[10px] text-zinc-500 font-mono">Cisco · Anthropic · AWS · Google</span>
          </div>
          <div class="flex flex-wrap gap-1.5 text-[11px]">
            <span class="rounded-md border border-zinc-800 bg-zinc-900 px-2 py-0.5 text-zinc-300 font-mono">
              Cisco: Cybersecurity & Networking
            </span>
            <span class="rounded-md border border-zinc-800 bg-zinc-900 px-2 py-0.5 text-zinc-300 font-mono">
              Anthropic: Model Context Protocol (MCP)
            </span>
            <span class="rounded-md border border-zinc-800 bg-zinc-900 px-2 py-0.5 text-zinc-300 font-mono">
              AWS: ML Foundations & GenAI
            </span>
            <span class="rounded-md border border-zinc-800 bg-zinc-900 px-2 py-0.5 text-zinc-300 font-mono">
              Google: Generative AI
            </span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
