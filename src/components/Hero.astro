---
import { ArrowRight, Mail, Github, Linkedin, Terminal, Download } from "lucide-astro";
---

<section id="home" class="relative overflow-hidden min-h-[calc(100vh-4rem)] flex items-center py-12 lg:py-0">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Bio & Info -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Location / Status Tag -->
        <div class="inline-flex items-center gap-2.5 rounded-full border border-zinc-300 dark:border-white/10 bg-zinc-100/90 dark:bg-zinc-900/80 px-3.5 py-1.5 text-xs text-zinc-700 dark:text-zinc-300 mb-6 backdrop-blur-sm shadow-xs">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span data-i18n="hero.status">Ingeniero en Sistemas de Información · UNS</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-zinc-900 dark:text-white leading-[1.1] mb-5">
          Julián Alconcher
        </h1>

        <!-- Subtitle & Bio -->
        <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-300 max-w-2xl font-normal leading-relaxed mb-8">
          <span class="text-zinc-900 dark:text-white font-semibold" data-i18n="hero.degree">Ingeniero en Sistemas de Información</span> <span data-i18n="hero.bio">y Desarrollador Full Stack. Construyo aplicaciones web modernas y software de alto rendimiento con tecnologías como React, Next.js, TypeScript, Node.js, Python, PostgreSQL, Swift y Tailwind CSS.</span>
        </p>

        <!-- Action Buttons (Clean & Solid) -->
        <div class="flex flex-wrap items-center gap-3 mb-10">
          <a
            href="#proyectos"
            class="inline-flex items-center gap-2 rounded-xl bg-zinc-900 dark:bg-white px-5 py-2.5 text-sm font-semibold text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors shadow-sm"
          >
            <span data-i18n="hero.btnProjects">Ver Proyectos</span>
            <ArrowRight class="h-4 w-4 text-zinc-400 dark:text-zinc-700" />
          </a>

          <a
            href="/CV_Julian_Alconcher.pdf"
            download="CV_Julian_Alconcher.pdf"
            class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900/90 px-4 py-2.5 text-sm font-semibold text-zinc-800 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-zinc-950 dark:hover:text-white transition-colors shadow-xs"
          >
            <Download class="h-4 w-4 text-zinc-500 dark:text-zinc-400" />
            <span data-i18n="hero.btnCv">Descargar CV</span>
          </a>

          <a
            href="#contacto"
            class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 dark:border-zinc-800 bg-white/70 dark:bg-zinc-900/50 px-4 py-2.5 text-sm font-semibold text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-white transition-colors"
          >
            <Mail class="h-4 w-4 text-zinc-500 dark:text-zinc-400" />
            <span data-i18n="hero.btnContact">Contacto</span>
          </a>

          <div class="flex items-center gap-1.5 pl-1">
            <a
              href="https://github.com/JulianAlconcher"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center h-10 w-10 rounded-xl border border-zinc-300 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-white transition-colors shadow-xs"
              aria-label="GitHub"
            >
              <Github class="h-4 w-4" />
            </a>

            <a
              href="https://www.linkedin.com/in/julian-alconcher"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center h-10 w-10 rounded-xl border border-zinc-300 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-white transition-colors shadow-xs"
              aria-label="LinkedIn"
            >
              <Linkedin class="h-4 w-4" />
            </a>
          </div>
        </div>

        <!-- Stats Bar (Understated & Crisp) -->
        <div class="grid grid-cols-3 gap-6 pt-6 border-t border-zinc-200 dark:border-zinc-800/80 w-full max-w-lg text-left">
          <div>
            <p class="text-xl font-bold text-zinc-900 dark:text-white font-mono">15</p>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5" data-i18n="hero.statsRepos">Repositorios</p>
          </div>
          <div>
            <p class="text-xl font-bold text-zinc-900 dark:text-white font-mono">UNS</p>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5" data-i18n="hero.statsDegree">Ing. en Sistemas</p>
          </div>
          <div>
            <p class="text-xl font-bold text-emerald-600 dark:text-emerald-400 font-mono">DCIC</p>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5" data-i18n="hero.statsCyber">Ciberseguridad</p>
          </div>
        </div>

      </div>

      <!-- Right Column: Clean UNIX Terminal -->
      <div class="lg:col-span-5 w-full">
        <div class="relative mx-auto w-full max-w-lg">
          
          <!-- Terminal Card -->
          <div class="rounded-2xl border border-zinc-300 dark:border-zinc-800 bg-[#0d0d11] shadow-xl overflow-hidden font-mono text-xs sm:text-sm">
            <!-- Window Bar -->
            <div class="flex items-center justify-between px-4 py-2.5 border-b border-zinc-800 bg-zinc-900/50">
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
                <span class="ml-2 text-[11px] text-zinc-400">julian@portfolio: ~</span>
              </div>
              <div class="text-[11px] text-zinc-500">zsh</div>
            </div>

            <!-- Terminal Body -->
            <div id="terminal-body" class="p-4 sm:p-5 h-72 overflow-y-auto space-y-2 text-left text-zinc-300">
              <div class="text-zinc-400" id="terminal-hint">
                Type <span class="text-zinc-100 font-semibold underline underline-offset-2">help</span> to list available commands.
              </div>
              <div class="pt-0.5 text-xs text-zinc-400" id="terminal-demo-line">
                <span class="text-zinc-500">➜</span> <span class="text-zinc-400">~</span> <span id="terminal-demo-text"></span><span class="animate-pulse">_</span>
              </div>

              <!-- History Log -->
              <div id="terminal-log" class="space-y-2"></div>

              <!-- Input Form -->
              <form id="terminal-form" class="flex items-center gap-2 pt-1">
                <span class="text-zinc-500 font-bold shrink-0">➜</span>
                <span class="text-zinc-400 shrink-0">~</span>
                <input
                  id="terminal-input"
                  type="text"
                  class="flex-1 bg-transparent text-white outline-none caret-white placeholder-zinc-600"
                  placeholder="help, projects, skills, whoami..."
                  autocomplete="off"
                  spellcheck="false"
                />
              </form>
            </div>

            <!-- Quick Command Shortcuts -->
            <div class="flex flex-wrap items-center gap-1.5 px-3 py-2 bg-zinc-900/30 border-t border-zinc-800/80 text-[11px]">
              <span class="text-zinc-500 text-[10px] pr-1" data-i18n="terminal.shortcuts">Shortcuts:</span>
              <button type="button" class="quick-cmd rounded px-2 py-0.5 bg-zinc-800 text-zinc-300 hover:bg-zinc-700 hover:text-white transition-colors" data-cmd="help">help</button>
              <button type="button" class="quick-cmd rounded px-2 py-0.5 bg-zinc-800 text-zinc-300 hover:bg-zinc-700 hover:text-white transition-colors" data-cmd="projects">projects</button>
              <button type="button" class="quick-cmd rounded px-2 py-0.5 bg-zinc-800 text-zinc-300 hover:bg-zinc-700 hover:text-white transition-colors" data-cmd="skills">skills</button>
              <button type="button" class="quick-cmd rounded px-2 py-0.5 bg-zinc-800 text-zinc-300 hover:bg-zinc-700 hover:text-white transition-colors" data-cmd="cat about.txt">about</button>
              <button type="button" class="quick-cmd rounded px-2 py-0.5 bg-amber-500/20 text-amber-300 border border-amber-500/30 hover:bg-amber-500/30 hover:text-white transition-colors font-bold" data-cmd="game">🎮 game</button>
              <button type="button" class="quick-cmd rounded px-2 py-0.5 bg-zinc-800 text-zinc-300 hover:bg-zinc-700 hover:text-white transition-colors" data-cmd="clear">clear</button>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { translations, type Lang } from "../data/i18n";

  const form = document.getElementById("terminal-form") as HTMLFormElement;
  const input = document.getElementById("terminal-input") as HTMLInputElement;
  const log = document.getElementById("terminal-log") as HTMLElement;
  const body = document.getElementById("terminal-body") as HTMLElement;
  const demoTextEl = document.getElementById("terminal-demo-text") as HTMLElement;
  const quickBtns = document.querySelectorAll(".quick-cmd");
  const hintEl = document.getElementById("terminal-hint");

  let currentLang: Lang = (document.documentElement.getAttribute("lang") as Lang) || "es";

  function getCommands(lang: Lang): Record<string, string> {
    const t = translations[lang].terminal;
    return {
      help: lang === "es"
        ? "Comandos disponibles:\n  • help          : Ver lista de comandos\n  • game / play   : 🎮 Jugar Bug Runner\n  • projects      : Listar proyectos destacados\n  • skills        : Listar tecnologías principales\n  • whoami        : Información de perfil\n  • cat about.txt : Leer biografía y educación\n  • cat contact.txt: Información de contacto\n  • clear         : Limpiar pantalla\n  • github        : Abrir perfil de GitHub"
        : "Available commands:\n  • help          : Show command list\n  • game / play   : 🎮 Play Bug Runner\n  • projects      : List flagship projects\n  • skills        : List primary tech stack\n  • whoami        : User profile info\n  • cat about.txt : Read bio & education\n  • cat contact.txt: Contact info\n  • clear         : Clear terminal output\n  • github        : Open GitHub profile",
      whoami: t.whoami,
      game: lang === "es" ? "🎮 ¡Iniciando Bug Runner! Desplazando al arcade..." : "🎮 Starting Bug Runner! Scrolling to arcade...",
      play: lang === "es" ? "🎮 ¡Iniciando Bug Runner! Desplazando al arcade..." : "🎮 Starting Bug Runner! Scrolling to arcade...",
      "cat about.txt": t.aboutText,
      "cat skills.txt": t.skillsText,
      "cat contact.txt": t.contactText,
      skills: lang === "es"
        ? "React, Next.js, Astro, TypeScript, Node.js, Python, Swift (macOS), C, PostgreSQL, Docker, Git"
        : "React, Next.js, Astro, TypeScript, Node.js, Python, Swift (macOS), C, PostgreSQL, Docker, Git",
      projects: t.projectsText,
      github: lang === "es" ? "Abriendo https://github.com/JulianAlconcher..." : "Opening https://github.com/JulianAlconcher..."
    };
  }

  let commands = getCommands(currentLang);

  window.addEventListener("portfolio-lang-change", (e: any) => {
    currentLang = e.detail.lang;
    commands = getCommands(currentLang);
    if (hintEl) {
      hintEl.innerHTML = currentLang === "es"
        ? 'Escribe <span class="text-zinc-100 font-semibold underline underline-offset-2">help</span> para listar comandos disponibles.'
        : 'Type <span class="text-zinc-100 font-semibold underline underline-offset-2">help</span> to list available commands.';
    }
  });

  const demoPhrases = [
    "cat about.txt",
    "ls -la projects/",
    "cat skills.txt",
    "whoami",
    "git status"
  ];

  let phraseIdx = 0;
  let charIdx = 0;
  let isDeleting = false;

  function typeDemo() {
    if (!demoTextEl) return;
    const current = demoPhrases[phraseIdx];
    if (!isDeleting) {
      charIdx++;
      demoTextEl.textContent = current.slice(0, charIdx);
      if (charIdx === current.length) {
        isDeleting = true;
        setTimeout(typeDemo, 1800);
        return;
      }
    } else {
      charIdx--;
      demoTextEl.textContent = current.slice(0, charIdx);
      if (charIdx === 0) {
        isDeleting = false;
        phraseIdx = (phraseIdx + 1) % demoPhrases.length;
      }
    }
    setTimeout(typeDemo, isDeleting ? 35 : 75);
  }
  typeDemo();

  function executeCommand(cmdStr: string) {
    const raw = cmdStr.trim();
    if (!raw) return;
    const lower = raw.toLowerCase();

    const cmdLine = document.createElement("div");
    cmdLine.className = "flex items-center gap-2 text-zinc-400";
    cmdLine.innerHTML = `<span class="text-zinc-500">➜</span> <span class="text-zinc-400">~</span> <span class="text-white">${raw}</span>`;
    log?.appendChild(cmdLine);

    if (lower === "clear") {
      log.innerHTML = "";
      if (input) input.value = "";
      return;
    }

    if (lower === "github") {
      window.open("https://github.com/JulianAlconcher", "_blank");
    }

    if (lower === "game" || lower === "play") {
      const arcadeEl = document.getElementById("arcade");
      if (arcadeEl) {
        setTimeout(() => {
          arcadeEl.scrollIntoView({ behavior: "smooth" });
        }, 400);
      }
    }

    const outputLine = document.createElement("div");
    outputLine.className = "text-zinc-300 whitespace-pre-line pl-2 border-l border-zinc-700 text-xs sm:text-sm";

    if (commands[lower]) {
      outputLine.textContent = commands[lower];
    } else if (lower.startsWith("echo ")) {
      outputLine.textContent = raw.slice(5);
    } else {
      outputLine.className += " text-rose-400";
      outputLine.textContent = currentLang === "es"
        ? `zsh: comando no encontrado: ${raw}. Escribe "help" para ver opciones.`
        : `zsh: command not found: ${raw}. Type "help" for options.`;
    }

    log?.appendChild(outputLine);
    if (input) input.value = "";
    body.scrollTop = body.scrollHeight;
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (input) executeCommand(input.value);
  });

  quickBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const cmd = btn.getAttribute("data-cmd");
      if (cmd) executeCommand(cmd);
    });
  });
</script>
