---
import { Mail, Linkedin, Github, Send, Copy, Check, MessageSquare, ArrowUpRight } from "lucide-astro";
---

<section id="contacto" class="relative py-24 sm:py-32 border-t border-white/10 bg-[#030712]/90">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 rounded-lg border border-blue-500/30 bg-blue-500/10 px-3 py-1 text-xs font-semibold text-blue-400 mb-3">
        <MessageSquare class="h-3.5 w-3.5" />
        <span>Contacto & Oportunidades</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        ¿Iniciamos una conversación?
      </h2>
      <p class="mt-4 text-base sm:text-lg text-gray-400">
        ¿Tienes una propuesta, un proyecto en mente o simplemente quieres charlar de tecnología? Escríbeme y responderé con gusto.
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 max-w-5xl mx-auto items-stretch">
      
      <!-- Contact Details & Socials (5 cols) -->
      <div class="lg:col-span-5 h-full flex flex-col justify-between space-y-6 rounded-3xl border border-white/10 bg-slate-900/60 p-6 sm:p-8 backdrop-blur-md">
        
        <div class="space-y-6">
          <h3 class="text-xl font-bold text-white">Canales directos</h3>

          <!-- Email Card -->
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-3">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-500/20 text-blue-400">
                <Mail class="h-5 w-5" />
              </div>
              <div>
                <p class="text-xs text-gray-400 font-medium">Correo electrónico</p>
                <p id="email-text" class="text-sm font-semibold text-white">alconcherjulian@gmail.com</p>
              </div>
            </div>

            <div class="flex items-center gap-2 pt-2">
              <a
                href="mailto:alconcherjulian@gmail.com"
                class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-xl bg-blue-600 px-3 py-2 text-xs font-semibold text-white hover:bg-blue-500 transition-colors"
              >
                <Mail class="h-3.5 w-3.5" />
                <span>Enviar Email</span>
              </a>

              <button
                id="copy-email-btn"
                type="button"
                class="inline-flex items-center justify-center gap-1 rounded-xl border border-white/15 bg-white/10 px-3 py-2 text-xs font-semibold text-gray-200 hover:bg-white/20 transition-all"
                title="Copiar email al portapapeles"
              >
                <Copy id="copy-icon" class="h-3.5 w-3.5" />
                <Check id="check-icon" class="h-3.5 w-3.5 text-emerald-400 hidden" />
                <span id="copy-label">Copiar</span>
              </button>
            </div>
          </div>

          <!-- Social Links -->
          <div class="space-y-2">
            <a
              href="https://github.com/JulianAlconcher"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between rounded-xl border border-white/10 bg-white/5 p-3.5 text-gray-300 hover:border-white/20 hover:bg-white/10 hover:text-white transition-all"
            >
              <div class="flex items-center gap-3">
                <div class="rounded-lg bg-white/10 p-2 text-white">
                  <Github class="h-4 w-4" />
                </div>
                <span class="text-sm font-medium">GitHub / JulianAlconcher</span>
              </div>
              <ArrowUpRight class="h-4 w-4 text-gray-500 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
            </a>

            <a
              href="https://www.linkedin.com/in/julian-alconcher"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between rounded-xl border border-white/10 bg-white/5 p-3.5 text-gray-300 hover:border-white/20 hover:bg-white/10 hover:text-white transition-all"
            >
              <div class="flex items-center gap-3">
                <div class="rounded-lg bg-blue-500/20 p-2 text-blue-400">
                  <Linkedin class="h-4 w-4" />
                </div>
                <span class="text-sm font-medium">LinkedIn / in/julian-alconcher</span>
              </div>
              <ArrowUpRight class="h-4 w-4 text-gray-500 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
            </a>
          </div>
        </div>

        <!-- Response Time Badge -->
        <div class="pt-4 border-t border-white/10 flex items-center gap-2 text-xs text-emerald-400">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Tiempo de respuesta habitual: &lt; 24hs</span>
        </div>

      </div>

      <!-- Quick Message Form (7 cols) -->
      <div class="lg:col-span-7 h-full flex flex-col justify-between rounded-3xl border border-white/10 bg-slate-900/60 p-6 sm:p-8 backdrop-blur-md">
        <h3 class="text-xl font-bold text-white mb-2">Envíame un mensaje</h3>
        <p class="text-xs text-gray-400 mb-6">Completa el formulario para enviarme un correo directamente.</p>

        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-xs font-semibold text-gray-300 mb-1.5">Tu Nombre</label>
              <input
                type="text"
                id="contact-name"
                required
                placeholder="Nombre o empresa"
                class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-gray-500 outline-none focus:border-blue-500 focus:bg-white/10 focus:ring-1 focus:ring-blue-500 transition-all"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-xs font-semibold text-gray-300 mb-1.5">Tu Email</label>
              <input
                type="email"
                id="contact-email"
                required
                placeholder="correo@ejemplo.com"
                class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-gray-500 outline-none focus:border-blue-500 focus:bg-white/10 focus:ring-1 focus:ring-blue-500 transition-all"
              />
            </div>
          </div>

          <div>
            <label for="contact-subject" class="block text-xs font-semibold text-gray-300 mb-1.5">Asunto</label>
            <input
              type="text"
              id="contact-subject"
              required
              placeholder="Proyecto, propuesta laboral, consulta..."
              class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-gray-500 outline-none focus:border-blue-500 focus:bg-white/10 focus:ring-1 focus:ring-blue-500 transition-all"
            />
          </div>

          <div>
            <label for="contact-msg" class="block text-xs font-semibold text-gray-300 mb-1.5">Mensaje</label>
            <textarea
              id="contact-msg"
              required
              rows="4"
              placeholder="Cuéntame sobre tu proyecto o necesidad..."
              class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-gray-500 outline-none focus:border-blue-500 focus:bg-white/10 focus:ring-1 focus:ring-blue-500 transition-all resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-linear-to-r from-blue-600 to-indigo-600 py-3 px-6 text-sm font-semibold text-white shadow-lg shadow-blue-500/20 hover:brightness-110 hover:shadow-blue-500/30 transition-all cursor-pointer"
          >
            <Send class="h-4 w-4" />
            <span>Enviar Mensaje</span>
          </button>
        </form>

        <div id="form-feedback" class="hidden mt-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3 text-xs text-emerald-300 text-center">
          ¡Gracias por escribir! Redirigiendo a tu cliente de correo para enviar el mensaje...
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Copy Email Clipboard
  const copyBtn = document.getElementById("copy-email-btn");
  const copyIcon = document.getElementById("copy-icon");
  const checkIcon = document.getElementById("check-icon");
  const copyLabel = document.getElementById("copy-label");

  copyBtn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText("alconcherjulian@gmail.com");
      copyIcon?.classList.add("hidden");
      checkIcon?.classList.remove("hidden");
      if (copyLabel) copyLabel.textContent = "¡Copiado!";

      setTimeout(() => {
        copyIcon?.classList.remove("hidden");
        checkIcon?.classList.add("hidden");
        if (copyLabel) copyLabel.textContent = "Copiar";
      }, 2500);
    } catch (err) {
      console.error("Failed to copy", err);
    }
  });

  // Contact Form Mailto redirect
  const contactForm = document.getElementById("contact-form") as HTMLFormElement;
  const feedback = document.getElementById("form-feedback") as HTMLElement;

  contactForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const name = (document.getElementById("contact-name") as HTMLInputElement)?.value || "";
    const email = (document.getElementById("contact-email") as HTMLInputElement)?.value || "";
    const subject = (document.getElementById("contact-subject") as HTMLInputElement)?.value || "";
    const msg = (document.getElementById("contact-msg") as HTMLTextAreaElement)?.value || "";

    const mailtoUri = `mailto:alconcherjulian@gmail.com?subject=${encodeURIComponent(subject + " - " + name)}&body=${encodeURIComponent("De: " + name + " (" + email + ")\n\n" + msg)}`;
    
    feedback?.classList.remove("hidden");
    
    setTimeout(() => {
      window.location.href = mailtoUri;
    }, 600);
  });
</script>
