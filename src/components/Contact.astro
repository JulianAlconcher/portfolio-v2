---
import { Mail, Linkedin, Github, Send, Copy, Check, ArrowUpRight } from "lucide-astro";
---

<section id="contacto" class="relative py-20 sm:py-28 border-t border-zinc-800/80 bg-[#09090b]">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="max-w-2xl mb-12">
      <p class="text-xs font-mono uppercase tracking-wider text-zinc-400 mb-2">
        Contacto
      </p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
        Hablemos
      </h2>
      <p class="mt-2 text-sm sm:text-base text-zinc-400">
        ¿Tienes una propuesta, un proyecto o te gustaría conversar? Puedes escribirme por email o LinkedIn.
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 max-w-5xl items-stretch">
      
      <!-- Contact Details (5 cols) -->
      <div class="lg:col-span-5 h-full flex flex-col justify-between space-y-6 rounded-2xl border border-zinc-800 bg-[#111114] p-6 sm:p-7">
        
        <div class="space-y-5">
          <h3 class="text-base font-bold text-white">Canales directos</h3>

          <!-- Email Card -->
          <div class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-4 space-y-3">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-zinc-800 text-zinc-200">
                <Mail class="h-4 w-4" />
              </div>
              <div>
                <p class="text-[11px] text-zinc-400 font-mono">Email</p>
                <p id="email-text" class="text-xs sm:text-sm font-semibold text-white">alconcherjulian@gmail.com</p>
              </div>
            </div>

            <div class="flex items-center gap-2 pt-1">
              <a
                href="mailto:alconcherjulian@gmail.com"
                class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg bg-white px-3 py-2 text-xs font-semibold text-zinc-900 hover:bg-zinc-200 transition-colors"
              >
                <Mail class="h-3.5 w-3.5" />
                <span>Enviar Email</span>
              </a>

              <button
                id="copy-email-btn"
                type="button"
                class="inline-flex items-center justify-center gap-1 rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-xs font-medium text-zinc-200 hover:bg-zinc-700 transition-colors cursor-pointer"
                title="Copiar email"
              >
                <Copy id="copy-icon" class="h-3.5 w-3.5" />
                <Check id="check-icon" class="h-3.5 w-3.5 text-emerald-400 hidden" />
                <span id="copy-label">Copiar</span>
              </button>
            </div>
          </div>

          <!-- Social Links -->
          <div class="space-y-2">
            <a
              href="https://github.com/JulianAlconcher"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between rounded-xl border border-zinc-800 bg-zinc-900/40 p-3 text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors"
            >
              <div class="flex items-center gap-3">
                <div class="rounded-lg bg-zinc-800 p-1.5 text-zinc-300">
                  <Github class="h-4 w-4" />
                </div>
                <span class="text-xs font-medium">GitHub / JulianAlconcher</span>
              </div>
              <ArrowUpRight class="h-3.5 w-3.5 text-zinc-500 group-hover:text-white transition-colors" />
            </a>

            <a
              href="https://www.linkedin.com/in/julian-alconcher"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between rounded-xl border border-zinc-800 bg-zinc-900/40 p-3 text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors"
            >
              <div class="flex items-center gap-3">
                <div class="rounded-lg bg-zinc-800 p-1.5 text-zinc-300">
                  <Linkedin class="h-4 w-4" />
                </div>
                <span class="text-xs font-medium">LinkedIn / in/julian-alconcher</span>
              </div>
              <ArrowUpRight class="h-3.5 w-3.5 text-zinc-500 group-hover:text-white transition-colors" />
            </a>
          </div>
        </div>

        <!-- Note -->
        <div class="pt-4 border-t border-zinc-800 flex items-center gap-2 text-xs text-zinc-400 font-mono">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
          <span>Respuesta habitual en &lt; 24hs</span>
        </div>

      </div>

      <!-- Quick Message Form (7 cols) -->
      <div class="lg:col-span-7 h-full flex flex-col justify-between rounded-2xl border border-zinc-800 bg-[#111114] p-6 sm:p-7">
        <div>
          <h3 class="text-base font-bold text-white mb-1">Envíame un mensaje</h3>
          <p class="text-xs text-zinc-400 mb-5">Completa el formulario para abrir tu cliente de correo con el mensaje listo.</p>

          <form id="contact-form" class="space-y-3.5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div>
                <label for="contact-name" class="block text-xs font-medium text-zinc-300 mb-1">Nombre</label>
                <input
                  type="text"
                  id="contact-name"
                  required
                  placeholder="Tu nombre"
                  class="w-full rounded-xl border border-zinc-800 bg-zinc-900 px-3.5 py-2 text-xs sm:text-sm text-white placeholder-zinc-500 outline-none focus:border-zinc-600 transition-colors"
                />
              </div>
              <div>
                <label for="contact-email" class="block text-xs font-medium text-zinc-300 mb-1">Email</label>
                <input
                  type="email"
                  id="contact-email"
                  required
                  placeholder="tu@email.com"
                  class="w-full rounded-xl border border-zinc-800 bg-zinc-900 px-3.5 py-2 text-xs sm:text-sm text-white placeholder-zinc-500 outline-none focus:border-zinc-600 transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="contact-subject" class="block text-xs font-medium text-zinc-300 mb-1">Asunto</label>
              <input
                type="text"
                id="contact-subject"
                required
                placeholder="Proyecto, propuesta laboral..."
                class="w-full rounded-xl border border-zinc-800 bg-zinc-900 px-3.5 py-2 text-xs sm:text-sm text-white placeholder-zinc-500 outline-none focus:border-zinc-600 transition-colors"
              />
            </div>

            <div>
              <label for="contact-msg" class="block text-xs font-medium text-zinc-300 mb-1">Mensaje</label>
              <textarea
                id="contact-msg"
                required
                rows="4"
                placeholder="Escribe tu mensaje aquí..."
                class="w-full rounded-xl border border-zinc-800 bg-zinc-900 px-3.5 py-2 text-xs sm:text-sm text-white placeholder-zinc-500 outline-none focus:border-zinc-600 transition-colors resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-white py-2.5 px-4 text-xs font-semibold text-zinc-900 hover:bg-zinc-200 transition-colors cursor-pointer"
            >
              <Send class="h-3.5 w-3.5" />
              <span>Enviar Mensaje</span>
            </button>
          </form>

          <div id="form-feedback" class="hidden mt-3 rounded-xl border border-zinc-700 bg-zinc-900 p-3 text-xs text-zinc-300 text-center">
            Redirigiendo a tu cliente de correo para enviar el mensaje...
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const copyBtn = document.getElementById("copy-email-btn");
  const copyIcon = document.getElementById("copy-icon");
  const checkIcon = document.getElementById("check-icon");
  const copyLabel = document.getElementById("copy-label");

  copyBtn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText("alconcherjulian@gmail.com");
      copyIcon?.classList.add("hidden");
      checkIcon?.classList.remove("hidden");
      if (copyLabel) copyLabel.textContent = "¡Copiado!";

      setTimeout(() => {
        copyIcon?.classList.remove("hidden");
        checkIcon?.classList.add("hidden");
        if (copyLabel) copyLabel.textContent = "Copiar";
      }, 2500);
    } catch (err) {
      console.error("Failed to copy", err);
    }
  });

  const contactForm = document.getElementById("contact-form") as HTMLFormElement;
  const feedback = document.getElementById("form-feedback") as HTMLElement;

  contactForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const name = (document.getElementById("contact-name") as HTMLInputElement)?.value || "";
    const email = (document.getElementById("contact-email") as HTMLInputElement)?.value || "";
    const subject = (document.getElementById("contact-subject") as HTMLInputElement)?.value || "";
    const msg = (document.getElementById("contact-msg") as HTMLTextAreaElement)?.value || "";

    const mailtoUri = `mailto:alconcherjulian@gmail.com?subject=${encodeURIComponent(subject + " - " + name)}&body=${encodeURIComponent("De: " + name + " (" + email + ")\n\n" + msg)}`;
    
    feedback?.classList.remove("hidden");
    
    setTimeout(() => {
      window.location.href = mailtoUri;
    }, 500);
  });
</script>
