---
import { Gamepad2, Volume2, VolumeX, RotateCcw, Play, Trophy, Sparkles } from "lucide-astro";
---

<section id="arcade" class="relative py-20 sm:py-28 border-t border-zinc-200 dark:border-zinc-800/80 bg-zinc-50 dark:bg-[#09090b] transition-colors duration-200 overflow-hidden">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-xs font-mono text-amber-600 dark:text-amber-400 mb-3">
          <Sparkles class="h-3.5 w-3.5" />
          <span data-i18n="game.badge">Easter Egg & Mini-Juego</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-white" data-i18n="game.title">
          Bug Runner — Esquiva los Bugs
        </h2>
        <p class="mt-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl" data-i18n="game.desc">
          ¿Mucho código por hoy? Tómate un respiro y ayuda al desarrollador a esquivar errores 500, memory leaks y bugs de producción.
        </p>
      </div>

      <!-- Controls & Audio Toggle -->
      <div class="flex items-center gap-3 self-start md:self-auto">
        <button
          id="game-sound-btn"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-xl border border-zinc-300 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-3 py-2 text-xs font-mono text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors shadow-xs cursor-pointer"
          title="Alternar sonido"
        >
          <Volume2 id="game-sound-on-icon" class="h-3.5 w-3.5 text-emerald-500" />
          <VolumeX id="game-sound-off-icon" class="h-3.5 w-3.5 text-zinc-400 hidden" />
          <span id="game-sound-label" data-i18n="game.soundOn">Sonido activado</span>
        </button>
      </div>
    </div>

    <!-- Arcade Cabinet Box -->
    <div class="relative mx-auto w-full max-w-4xl rounded-2xl sm:rounded-3xl border border-zinc-300 dark:border-zinc-800 bg-zinc-950 p-2 sm:p-4 shadow-2xl overflow-hidden font-mono">
      
      <!-- Top Arcade Bar -->
      <div class="flex items-center justify-between px-3 py-2 text-xs text-zinc-400 border-b border-zinc-800/80 mb-2">
        <div class="flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
          <span class="ml-2 text-[11px] text-zinc-400 font-bold hidden sm:inline">DEV_ARCADE_V1.0</span>
        </div>

        <div class="flex items-center gap-4 text-xs font-mono">
          <div class="flex items-center gap-1.5">
            <Trophy class="h-3.5 w-3.5 text-amber-400" />
            <span class="text-zinc-500" data-i18n="game.highScore">Récord:</span>
            <span id="game-highscore" class="font-bold text-amber-400">0</span>
          </div>

          <div class="flex items-center gap-1.5 bg-zinc-900 border border-zinc-800 px-2.5 py-0.5 rounded-lg">
            <span class="text-zinc-500" data-i18n="game.score">Puntaje:</span>
            <span id="game-score" class="font-bold text-white">0</span>
          </div>
        </div>
      </div>

      <!-- Canvas Area -->
      <div class="relative w-full h-64 sm:h-80 bg-[#0d0d12] rounded-xl overflow-hidden cursor-pointer select-none">
        <canvas id="game-canvas" class="w-full h-full block"></canvas>

        <!-- Initial Start Overlay Screen -->
        <div
          id="game-start-overlay"
          class="absolute inset-0 flex flex-col items-center justify-center bg-black/60 backdrop-blur-xs p-6 text-center transition-opacity"
        >
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-zinc-900 border border-zinc-700 text-amber-400 mb-3 shadow-lg animate-bounce">
            <Gamepad2 class="h-7 w-7" />
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-white mb-2" data-i18n="game.title">
            Bug Runner
          </h3>
          <p class="text-xs text-zinc-300 max-w-sm mb-5">
            <span class="hidden sm:inline" data-i18n="game.instructionsDesktop">Presiona Espacio o Flecha Arriba para saltar</span>
            <span class="sm:hidden" data-i18n="game.instructionsMobile">Toca la pantalla para saltar</span>
          </p>
          <button
            id="game-start-btn"
            type="button"
            class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-2.5 text-sm font-bold text-zinc-950 hover:bg-zinc-200 transition-all transform hover:scale-105 active:scale-95 cursor-pointer shadow-md"
            data-i18n="game.start"
          >
            <Play class="h-4 w-4 fill-zinc-950" />
            <span>Jugar ahora</span>
          </button>
        </div>

        <!-- Game Over Overlay Screen -->
        <div
          id="game-over-overlay"
          class="hidden absolute inset-0 flex flex-col items-center justify-center bg-black/80 backdrop-blur-xs p-6 text-center"
        >
          <div class="text-3xl mb-2">💥</div>
          <h3 class="text-xl font-bold text-rose-400 mb-1" data-i18n="game.gameOver">
            ¡Oops! ¡El bug llegó a producción!
          </h3>
          <p class="text-xs text-zinc-400 mb-4 font-mono">
            Puntaje final: <span id="game-over-score" class="font-bold text-white text-sm">0</span>
          </p>
          <button
            id="game-restart-btn"
            type="button"
            class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-2.5 text-sm font-bold text-zinc-950 hover:bg-zinc-200 transition-all transform hover:scale-105 active:scale-95 cursor-pointer shadow-md"
            data-i18n="game.restart"
          >
            <RotateCcw class="h-4 w-4" />
            <span>Reintentar</span>
          </button>
        </div>

        <!-- Mobile Touch Jump Indicator -->
        <div class="sm:hidden absolute bottom-2 right-3 pointer-events-none text-[10px] text-zinc-500 font-mono">
          Tap = Saltar ⬆
        </div>
      </div>

      <!-- Footer Hints -->
      <div class="flex flex-wrap items-center justify-between gap-2 px-3 pt-3 text-[11px] text-zinc-500">
        <div class="flex items-center gap-3">
          <span>🎮 <strong class="text-zinc-300">Espacio / Click / Tap</strong> = Saltar</span>
          <span class="hidden sm:inline">☕ <strong class="text-zinc-300">+50 Puntos</strong></span>
          <span class="hidden sm:inline">🐛 / 🛑 / 💥 = <strong class="text-rose-400">Esquivar</strong></span>
        </div>
        <div class="text-zinc-600 font-mono">
          Tip: ¡Permite doble salto en el aire!
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  import { translations, type Lang } from "../data/i18n";

  const canvas = document.getElementById("game-canvas") as HTMLCanvasElement;
  const ctx = canvas?.getContext("2d");
  const startOverlay = document.getElementById("game-start-overlay");
  const startBtn = document.getElementById("game-start-btn");
  const gameOverOverlay = document.getElementById("game-over-overlay");
  const restartBtn = document.getElementById("game-restart-btn");
  const scoreDisplay = document.getElementById("game-score");
  const highScoreDisplay = document.getElementById("game-highscore");
  const gameOverScoreDisplay = document.getElementById("game-over-score");
  const soundBtn = document.getElementById("game-sound-btn");
  const soundOnIcon = document.getElementById("game-sound-on-icon");
  const soundOffIcon = document.getElementById("game-sound-off-icon");
  const soundLabel = document.getElementById("game-sound-label");

  let currentLang: Lang = (document.documentElement.getAttribute("lang") as Lang) || "es";
  let soundEnabled = true;

  // Audio synthesis using Web Audio API
  let audioCtx: AudioContext | null = null;

  function initAudio() {
    if (!audioCtx) {
      const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
      if (AudioContextClass) {
        audioCtx = new AudioContextClass();
      }
    }
    if (audioCtx && audioCtx.state === "suspended") {
      audioCtx.resume();
    }
  }

  function playSound(type: "jump" | "coffee" | "hit" | "start") {
    if (!soundEnabled || !audioCtx) return;
    try {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      const now = audioCtx.currentTime;

      if (type === "jump") {
        osc.type = "sine";
        osc.frequency.setValueAtTime(220, now);
        osc.frequency.exponentialRampToValueAtTime(580, now + 0.12);
        gain.gain.setValueAtTime(0.15, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.12);
        osc.start(now);
        osc.stop(now + 0.12);
      } else if (type === "coffee") {
        osc.type = "triangle";
        osc.frequency.setValueAtTime(523.25, now);
        osc.frequency.setValueAtTime(659.25, now + 0.08);
        osc.frequency.setValueAtTime(783.99, now + 0.16);
        gain.gain.setValueAtTime(0.2, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
        osc.start(now);
        osc.stop(now + 0.25);
      } else if (type === "hit") {
        osc.type = "sawtooth";
        osc.frequency.setValueAtTime(160, now);
        osc.frequency.exponentialRampToValueAtTime(40, now + 0.3);
        gain.gain.setValueAtTime(0.25, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
        osc.start(now);
        osc.stop(now + 0.3);
      } else if (type === "start") {
        osc.type = "sine";
        osc.frequency.setValueAtTime(330, now);
        osc.frequency.exponentialRampToValueAtTime(660, now + 0.15);
        gain.gain.setValueAtTime(0.15, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
        osc.start(now);
        osc.stop(now + 0.15);
      }
    } catch (e) {
      // Audio fallback
    }
  }

  soundBtn?.addEventListener("click", () => {
    soundEnabled = !soundEnabled;
    if (soundEnabled) {
      soundOnIcon?.classList.remove("hidden");
      soundOffIcon?.classList.add("hidden");
      if (soundLabel) soundLabel.textContent = translations[currentLang].game.soundOn;
      initAudio();
      playSound("jump");
    } else {
      soundOnIcon?.classList.add("hidden");
      soundOffIcon?.classList.remove("hidden");
      if (soundLabel) soundLabel.textContent = translations[currentLang].game.soundOff;
    }
  });

  window.addEventListener("portfolio-lang-change", (e: any) => {
    currentLang = e.detail.lang;
    if (soundLabel) {
      soundLabel.textContent = soundEnabled ? translations[currentLang].game.soundOn : translations[currentLang].game.soundOff;
    }
  });

  let isRunning = false;
  let score = 0;
  let highScore = Number(localStorage.getItem("bugrunner_highscore") || 0);
  if (highScoreDisplay) highScoreDisplay.textContent = highScore.toString();

  let animFrameId: number;
  let gameSpeed = 5.5;
  let width = 800;
  let height = 300;
  let groundY = 250;

  function resizeCanvas() {
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    width = rect.width || 800;
    height = rect.height || 300;
    canvas.width = width * window.devicePixelRatio;
    canvas.height = height * window.devicePixelRatio;
    if (ctx) {
      ctx.resetTransform();
      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }
    groundY = height - 40;
  }

  window.addEventListener("resize", resizeCanvas);
  resizeCanvas();

  const player = {
    x: 50,
    y: 0,
    w: 32,
    h: 42,
    vy: 0,
    gravity: 0.65,
    jumpForce: -12.5,
    isGrounded: false,
    jumpCount: 0,
    maxJumps: 2,
    runFrame: 0
  };

  interface Obstacle {
    x: number;
    y: number;
    w: number;
    h: number;
    type: "bug" | "leak" | "err500" | "coffee";
    label: string;
    color: string;
    collected?: boolean;
  }

  let obstacles: Obstacle[] = [];
  let nextObstacleTime = 0;
  let backgroundParticles: { x: number; y: number; text: string; speed: number; opacity: number }[] = [];

  const codeSymbols = ["{", "}", ";", "=>", "</>", "&&", "||", "git", "npm", "0", "1", "const", "def"];

  function initBackground() {
    backgroundParticles = [];
    for (let i = 0; i < 15; i++) {
      backgroundParticles.push({
        x: Math.random() * width,
        y: Math.random() * (groundY - 30),
        text: codeSymbols[Math.floor(Math.random() * codeSymbols.length)],
        speed: 0.5 + Math.random() * 1.5,
        opacity: 0.15 + Math.random() * 0.25
      });
    }
  }

  function resetGame() {
    resizeCanvas();
    score = 0;
    gameSpeed = 5.5;
    player.x = width < 480 ? 30 : 60;
    player.y = groundY - player.h;
    player.vy = 0;
    player.jumpCount = 0;
    obstacles = [];
    nextObstacleTime = 50;
    initBackground();
    if (scoreDisplay) scoreDisplay.textContent = "0";
  }

  function spawnObstacle() {
    const isCoffee = Math.random() < 0.25;
    
    if (isCoffee) {
      obstacles.push({
        x: width + 20,
        y: groundY - 55 - Math.random() * 40,
        w: 22,
        h: 24,
        type: "coffee",
        label: "☕",
        color: "#10b981"
      });
      return;
    }

    const roll = Math.random();
    if (roll < 0.4) {
      obstacles.push({
        x: width + 20,
        y: groundY - 26,
        w: 28,
        h: 26,
        type: "bug",
        label: "🐛",
        color: "#f43f5e"
      });
    } else if (roll < 0.75) {
      obstacles.push({
        x: width + 20,
        y: groundY - 36,
        w: 32,
        h: 36,
        type: "leak",
        label: "null",
        color: "#fbbf24"
      });
    } else {
      obstacles.push({
        x: width + 20,
        y: groundY - 44,
        w: 38,
        h: 44,
        type: "err500",
        label: "500",
        color: "#ef4444"
      });
    }
  }

  function jump() {
    initAudio();
    if (!isRunning) {
      startGame();
      return;
    }

    if (player.jumpCount < player.maxJumps) {
      player.vy = player.jumpForce;
      player.isGrounded = false;
      player.jumpCount++;
      playSound("jump");
    }
  }

  function startGame() {
    initAudio();
    resetGame();
    isRunning = true;
    startOverlay?.classList.add("hidden");
    gameOverOverlay?.classList.add("hidden");
    playSound("start");
    requestAnimationFrame(gameLoop);
  }

  function gameOver() {
    isRunning = false;
    playSound("hit");
    cancelAnimationFrame(animFrameId);

    if (score > highScore) {
      highScore = score;
      localStorage.setItem("bugrunner_highscore", highScore.toString());
      if (highScoreDisplay) highScoreDisplay.textContent = highScore.toString();
    }

    if (gameOverScoreDisplay) gameOverScoreDisplay.textContent = score.toString();
    gameOverOverlay?.classList.remove("hidden");
  }

  function gameLoop() {
    if (!isRunning || !ctx) return;

    score += 1;
    if (scoreDisplay) scoreDisplay.textContent = score.toString();

    if (score % 250 === 0 && gameSpeed < 11) {
      gameSpeed += 0.4;
    }

    player.vy += player.gravity;
    player.y += player.vy;

    if (player.y >= groundY - player.h) {
      player.y = groundY - player.h;
      player.vy = 0;
      player.isGrounded = true;
      player.jumpCount = 0;
    } else {
      player.isGrounded = false;
    }

    player.runFrame += 0.2;

    nextObstacleTime -= 1;
    if (nextObstacleTime <= 0) {
      spawnObstacle();
      const minDistance = Math.max(60, 110 - gameSpeed * 5);
      nextObstacleTime = minDistance + Math.floor(Math.random() * 50);
    }

    for (let i = obstacles.length - 1; i >= 0; i--) {
      const ob = obstacles[i];
      ob.x -= gameSpeed;

      if (!ob.collected) {
        const hit =
          player.x < ob.x + ob.w - 4 &&
          player.x + player.w > ob.x + 4 &&
          player.y < ob.y + ob.h - 4 &&
          player.y + player.h > ob.y + 4;

        if (hit) {
          if (ob.type === "coffee") {
            ob.collected = true;
            score += 50;
            playSound("coffee");
          } else {
            gameOver();
            return;
          }
        }
      }

      if (ob.x < -60) {
        obstacles.splice(i, 1);
      }
    }

    backgroundParticles.forEach((p) => {
      p.x -= p.speed;
      if (p.x < -30) {
        p.x = width + 20;
        p.y = Math.random() * (groundY - 30);
      }
    });

    ctx.clearRect(0, 0, width, height);

    ctx.font = "11px monospace";
    backgroundParticles.forEach((p) => {
      ctx.fillStyle = `rgba(161, 161, 170, ${p.opacity})`;
      ctx.fillText(p.text, p.x, p.y);
    });

    ctx.strokeStyle = "#27272a";
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(0, groundY);
    ctx.lineTo(width, groundY);
    ctx.stroke();

    ctx.strokeStyle = "#3f3f46";
    ctx.lineWidth = 2;
    const dashOffset = (score * gameSpeed) % 40;
    for (let x = -dashOffset; x < width; x += 40) {
      ctx.beginPath();
      ctx.moveTo(x, groundY + 4);
      ctx.lineTo(x + 16, groundY + 4);
      ctx.stroke();
    }

    drawPlayer(ctx, player.x, player.y, player.w, player.h, player.isGrounded, Math.floor(player.runFrame));

    obstacles.forEach((ob) => {
      if (ob.collected) return;

      if (ob.type === "coffee") {
        ctx.fillStyle = "#10b981";
        ctx.font = "20px monospace";
        ctx.fillText("☕", ob.x, ob.y + ob.h);
      } else if (ob.type === "bug") {
        ctx.font = "22px monospace";
        ctx.fillText("🐛", ob.x - 2, ob.y + ob.h);
      } else if (ob.type === "leak") {
        ctx.fillStyle = "#18181b";
        ctx.strokeStyle = "#f59e0b";
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.roundRect(ob.x, ob.y, ob.w, ob.h, 6);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#f59e0b";
        ctx.font = "bold 10px monospace";
        ctx.textAlign = "center";
        ctx.fillText("null", ob.x + ob.w / 2, ob.y + ob.h / 2 + 3.5);
        ctx.textAlign = "left";
      } else if (ob.type === "err500") {
        ctx.fillStyle = "#27272a";
        ctx.strokeStyle = "#ef4444";
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.roundRect(ob.x, ob.y, ob.w, ob.h, 6);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#ef4444";
        ctx.font = "bold 11px monospace";
        ctx.textAlign = "center";
        ctx.fillText("500", ob.x + ob.w / 2, ob.y + ob.h / 2 - 2);
        ctx.fillStyle = "#a1a1aa";
        ctx.font = "8px monospace";
        ctx.fillText("ERR", ob.x + ob.w / 2, ob.y + ob.h / 2 + 10);
        ctx.textAlign = "left";
      }
    });

    animFrameId = requestAnimationFrame(gameLoop);
  }

  function drawPlayer(c: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, isGrounded: boolean, frame: number) {
    c.save();
    
    // Hoodie
    c.fillStyle = "#38bdf8";
    c.beginPath();
    c.roundRect(x + 6, y + 10, 20, 20, 4);
    c.fill();

    // Head / Face
    c.fillStyle = "#fde047";
    c.beginPath();
    c.arc(x + 16, y + 8, 7, 0, Math.PI * 2);
    c.fill();

    // Glasses
    c.fillStyle = "#09090b";
    c.fillRect(x + 15, y + 6, 6, 3);
    c.fillStyle = "#38bdf8";
    c.fillRect(x + 16, y + 7, 4, 1);

    // Laptop
    c.fillStyle = "#e4e4e7";
    c.fillRect(x + 19, y + 18, 10, 7);
    c.fillStyle = "#3b82f6";
    c.fillRect(x + 20, y + 19, 8, 5);

    // Legs
    c.strokeStyle = "#38bdf8";
    c.lineWidth = 3;
    c.lineCap = "round";

    if (!isGrounded) {
      c.beginPath();
      c.moveTo(x + 10, y + 30);
      c.lineTo(x + 4, y + 37);
      c.stroke();

      c.beginPath();
      c.moveTo(x + 22, y + 30);
      c.lineTo(x + 26, y + 37);
      c.stroke();
    } else {
      const isAlt = frame % 2 === 0;
      c.beginPath();
      c.moveTo(x + 11, y + 30);
      c.lineTo(isAlt ? x + 5 : x + 18, y + 40);
      c.stroke();

      c.beginPath();
      c.moveTo(x + 21, y + 30);
      c.lineTo(isAlt ? x + 25 : x + 9, y + 40);
      c.stroke();
    }

    c.restore();
  }

  window.addEventListener("keydown", (e) => {
    if (e.code === "Space" || e.code === "ArrowUp") {
      const arcadeEl = document.getElementById("arcade");
      const rect = arcadeEl?.getBoundingClientRect();
      const inView = rect && rect.top < window.innerHeight && rect.bottom > 0;
      
      if (inView || isRunning) {
        e.preventDefault();
        jump();
      }
    }
  });

  canvas?.addEventListener("pointerdown", (e) => {
    e.preventDefault();
    jump();
  });

  startBtn?.addEventListener("click", startGame);
  restartBtn?.addEventListener("click", startGame);
</script>
