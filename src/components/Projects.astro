---
import { projects, categories } from "../data/projects";
import { Github, ExternalLink, Search, Layers, Star, AlertCircle, X, Check, Sparkles, ArrowRight, BookOpen } from "lucide-astro";
---

<section id="proyectos" class="relative py-20 sm:py-28 border-t border-zinc-200 dark:border-zinc-800/80 bg-zinc-50 dark:bg-[#09090b] transition-colors duration-200">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
      <div>
        <p class="text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2" data-i18n="projects.subtitle">
          Portfolio de Software
        </p>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-white" data-i18n="projects.title">
          Proyectos & Aplicaciones
        </h2>
        <p class="mt-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl" data-i18n="projects.desc">
          Soluciones de agricultura satelital con Machine Learning, sitios web en producción, aplicaciones de sistemas en macOS y proyectos de código abierto.
        </p>
      </div>

      <!-- Quick External Link -->
      <a
        href="https://github.com/JulianAlconcher?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 px-4 py-2 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all self-start md:self-auto shadow-xs"
      >
        <Github class="h-3.5 w-3.5" />
        <span>GitHub ({projects.length} repos)</span>
        <ExternalLink class="h-3 w-3 text-zinc-400" />
      </a>
    </div>

    <!-- Interactive Filter & Search Bar -->
    <div class="mb-10 space-y-4">
      <!-- Search Input -->
      <div class="relative max-w-md">
        <Search class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-400 dark:text-zinc-500" />
        <input
          id="project-search"
          type="text"
          placeholder="Buscar por tecnología o nombre (ej: React, Swift, NDVI)..."
          data-i18n-placeholder="projects.searchPlaceholder"
          class="w-full rounded-xl border border-zinc-300 dark:border-zinc-800 bg-white dark:bg-zinc-900/80 pl-10 pr-8 py-2.5 text-xs sm:text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 outline-none focus:border-zinc-500 dark:focus:border-zinc-600 transition-colors font-sans shadow-xs"
        />
        <button
          id="clear-search-btn"
          type="button"
          class="hidden absolute right-3 top-1/2 -translate-y-1/2 rounded text-xs text-zinc-400 hover:text-zinc-800 dark:hover:text-white"
          title="Limpiar"
        >
          ✕
        </button>
      </div>

      <!-- Category Filter Pills (Minimalist Segmented Control) -->
      <div class="flex flex-wrap items-center gap-1.5 p-1 rounded-xl bg-zinc-200/70 dark:bg-zinc-900/80 border border-zinc-300/80 dark:border-zinc-800/80 w-fit">
        {categories.map((cat) => (
          <button
            type="button"
            class="filter-pill rounded-lg px-3 py-1.5 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 transition-all cursor-pointer flex items-center gap-1.5 data-[active=true]:bg-white data-[active=true]:text-zinc-900 dark:data-[active=true]:bg-zinc-800 dark:data-[active=true]:text-white data-[active=true]:shadow-xs"
            data-category={cat.id}
            data-active={cat.id === "all" ? "true" : "false"}
          >
            <span class="cat-label" data-cat-id={cat.id}>{cat.label}</span>
            <span class="text-[10px] text-zinc-400 dark:text-zinc-500 font-mono">
              {cat.count}
            </span>
          </button>
        ))}
      </div>

      <!-- Live Counter -->
      <div class="flex items-center justify-between text-xs text-zinc-500 font-mono">
        <span id="results-count">Mostrando {projects.length} de {projects.length} proyectos</span>
        <button id="reset-filters" class="hidden text-zinc-600 dark:text-zinc-400 hover:underline" data-i18n="projects.reset">Restablecer</button>
      </div>
    </div>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <article
          class="project-card group relative flex flex-col overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-[#111114] transition-all duration-200 hover:-translate-y-1 hover:border-zinc-400 dark:hover:border-zinc-700 shadow-xs hover:shadow-md"
          data-project-id={project.id}
          data-category={project.category}
          data-featured={project.featured ? "true" : "false"}
          data-tech={project.tech.join(" ").toLowerCase()}
          data-title={project.title.toLowerCase()}
          data-description={project.description.toLowerCase()}
        >
          <!-- Project Thumbnail Image / Header -->
          <div
            class="open-modal-trigger relative h-44 w-full overflow-hidden bg-zinc-100 dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800 cursor-pointer"
            data-project-id={project.id}
          >
            <img
              src={project.image}
              alt={project.title}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/30 to-transparent"></div>
            
            <!-- Category Badge Pill -->
            <div class="absolute top-3 left-3 z-10">
              <span class="inline-flex items-center gap-1.5 rounded-lg border border-white/20 bg-black/60 px-2.5 py-1 text-[11px] font-medium text-white backdrop-blur-md">
                {project.featured && <span class="h-1.5 w-1.5 rounded-full bg-blue-400"></span>}
                {project.badge}
              </span>
            </div>

            <!-- Stars count if available -->
            {project.stars > 0 && (
              <div class="absolute top-3 right-3 z-10">
                <span class="inline-flex items-center gap-1 rounded-lg border border-amber-400/30 bg-black/60 px-2 py-0.5 text-[11px] font-medium text-amber-300 backdrop-blur-md">
                  <Star class="h-3 w-3 fill-amber-400" />
                  {project.stars}
                </span>
              </div>
            )}

            <!-- Title on image bottom -->
            <div class="absolute bottom-3 left-4 right-4 z-10">
              <h3 class="text-lg font-bold text-white transition-colors group-hover:text-blue-300">
                {project.title}
              </h3>
            </div>
          </div>

          <!-- Project Card Content -->
          <div class="flex flex-1 flex-col p-5 justify-between">
            
            <!-- Top Section: Description & Challenge -->
            <div class="space-y-3 flex flex-col">
              <!-- Description with uniform height -->
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed line-clamp-3 min-h-[4rem]">
                {project.description}
              </p>

              <!-- Challenge / Note Box with uniform fixed height & alignment -->
              <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/50 p-3 text-xs min-h-[4.75rem] flex flex-col justify-center">
                <span class="font-mono text-[10px] uppercase text-zinc-500 block mb-0.5 font-semibold" data-i18n="projects.challenge">Desafío</span>
                <span class="text-zinc-700 dark:text-zinc-300 line-clamp-2 leading-relaxed">{project.challenge}</span>
              </div>
            </div>

            <!-- Bottom Section: Tech Badges & Links pinned to bottom -->
            <div class="mt-4 pt-1 space-y-3.5">
              <!-- Tech Badges with uniform height -->
              <div class="flex flex-wrap content-start gap-1.5 min-h-[3.75rem] max-h-[4.25rem] overflow-hidden">
                {project.tech.map((t) => (
                  <span class="rounded-md border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900/80 px-2 py-0.5 text-[11px] font-mono text-zinc-700 dark:text-zinc-400">
                    {t}
                  </span>
                ))}
              </div>

              <!-- Action Links / Footer -->
              <div class="flex items-center justify-between pt-3 border-t border-zinc-200 dark:border-zinc-800 text-xs">
                
                <!-- Open Deep-Dive Modal Button -->
                <button
                  type="button"
                  class="open-modal-trigger inline-flex items-center gap-1.5 text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white font-medium cursor-pointer text-xs transition-colors"
                  data-project-id={project.id}
                  title="Ver detalles técnicos del proyecto"
                >
                  <BookOpen class="h-3.5 w-3.5 text-blue-500" />
                  <span data-i18n="modal.viewDetails">Detalles</span>
                </button>

                <!-- Repos & Live Links -->
                <div class="flex items-center gap-2 shrink-0">
                  {project.github && (
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700/80 bg-zinc-100 dark:bg-zinc-800/80 px-2.5 py-1 text-xs font-medium text-zinc-800 dark:text-zinc-200 hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:text-zinc-950 dark:hover:text-white transition-colors"
                      title="Ver Código"
                    >
                      <Github class="h-3.5 w-3.5" />
                      <span data-i18n="projects.repo">Repo</span>
                    </a>
                  )}

                  {project.demo && (
                    <a
                      href={project.demo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-lg bg-zinc-900 dark:bg-white px-2.5 py-1 text-xs font-semibold text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors shadow-xs"
                      title="Ver Sitio en Vivo"
                    >
                      <ExternalLink class="h-3 w-3" />
                      <span data-i18n="projects.live">Live</span>
                    </a>
                  )}
                </div>
              </div>
            </div>

          </div>
        </article>
      ))}
    </div>

    <!-- Empty Results State -->
    <div id="no-results" class="hidden text-center py-16 px-4">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-500 mb-3">
        <AlertCircle class="h-6 w-6" />
      </div>
      <h3 class="text-sm font-semibold text-zinc-900 dark:text-white mb-1" data-i18n="projects.noResultsTitle">No se encontraron proyectos</h3>
      <p class="text-xs text-zinc-500 max-w-sm mx-auto mb-4" data-i18n="projects.noResultsDesc">
        Prueba buscando con otro término o seleccionando "Todos".
      </p>
      <button
        id="empty-reset-btn"
        type="button"
        class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 dark:bg-zinc-800 px-3.5 py-1.5 text-xs font-medium text-white hover:bg-zinc-800 dark:hover:bg-zinc-700 transition-colors"
        data-i18n="projects.clearFilters"
      >
        Limpiar Filtros
      </button>
    </div>

  </div>

  <!-- Deep-Dive Modal Backdrop (Optimized for Mobile & Desktop) -->
  <div
    id="project-modal"
    class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 md:p-6 bg-black/75 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
  >
    <!-- Modal Card Dialog (Bottom-sheet on mobile, centered modal on desktop) -->
    <div
      id="modal-dialog"
      class="relative w-full max-w-2xl max-h-[92vh] sm:max-h-[85vh] flex flex-col overflow-hidden rounded-t-3xl sm:rounded-2xl border-t sm:border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#111114] shadow-2xl text-zinc-900 dark:text-zinc-100 transform translate-y-8 sm:translate-y-0 sm:scale-95 transition-all duration-300"
    >
      <!-- Pull handle for mobile -->
      <div class="sm:hidden flex justify-center pt-2.5 pb-1 bg-zinc-900">
        <div class="h-1 w-10 rounded-full bg-zinc-600"></div>
      </div>

      <!-- Modal Header Banner -->
      <div class="relative h-36 sm:h-48 w-full overflow-hidden bg-zinc-900 shrink-0">
        <img id="modal-img" src="" alt="" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/50 to-transparent"></div>

        <!-- Close Button (Always visible & tap-friendly) -->
        <button
          id="modal-close-btn"
          type="button"
          class="absolute top-3 right-3 z-20 flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-full sm:rounded-xl bg-black/70 border border-white/25 text-white hover:bg-black transition-colors cursor-pointer shadow-md"
          aria-label="Cerrar modal"
        >
          <X class="h-4 w-4" />
        </button>

        <!-- Badge & Title -->
        <div class="absolute bottom-3 left-4 right-12 sm:left-6 sm:right-6 z-10 space-y-0.5 sm:space-y-1">
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <span id="modal-badge" class="inline-flex items-center rounded-md border border-white/20 bg-black/70 px-2 py-0.5 text-[10px] sm:text-[11px] font-mono text-white backdrop-blur-sm"></span>
            <span id="modal-role" class="text-[11px] sm:text-xs text-zinc-300 font-mono truncate max-w-[200px]"></span>
          </div>
          <h2 id="modal-title" class="text-lg sm:text-2xl font-bold text-white leading-tight"></h2>
        </div>
      </div>

      <!-- Scrollable Modal Content (Compact & Mobile-friendly) -->
      <div class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4 sm:space-y-5 text-xs sm:text-sm">
        
        <!-- Summary / Overview -->
        <div>
          <h4 class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5 font-bold flex items-center gap-1.5" data-i18n="modal.overview">
            Descripción General
          </h4>
          <p id="modal-summary" class="text-zinc-700 dark:text-zinc-300 leading-relaxed text-xs sm:text-sm"></p>
        </div>

        <!-- Architecture & Technical Decisions -->
        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/60 p-3.5 sm:p-4 space-y-1.5">
          <h4 class="text-[11px] font-mono uppercase tracking-wider text-zinc-900 dark:text-zinc-200 font-bold flex items-center gap-1.5" data-i18n="modal.architecture">
            Arquitectura & Decisiones Técnicas
          </h4>
          <p id="modal-architecture" class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed"></p>
        </div>

        <!-- Key Features List -->
        <div>
          <h4 class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2 font-bold flex items-center gap-1.5" data-i18n="modal.features">
            Funcionalidades Clave
          </h4>
          <ul id="modal-features-list" class="space-y-1.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300"></ul>
        </div>

        <!-- Real-world Impact / Outcome -->
        <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3.5 sm:p-4 space-y-1">
          <h4 class="text-[11px] font-mono uppercase tracking-wider text-emerald-700 dark:text-emerald-300 font-bold flex items-center gap-1.5" data-i18n="modal.impact">
            Impacto & Resultados
          </h4>
          <p id="modal-impact" class="text-xs sm:text-sm text-zinc-800 dark:text-zinc-200 leading-relaxed"></p>
        </div>

        <!-- Tech Stack Pills in Modal -->
        <div>
          <h4 class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5 font-bold">
            Stack Tecnológico
          </h4>
          <div id="modal-tech-pills" class="flex flex-wrap gap-1.5"></div>
        </div>

      </div>

      <!-- Modal Footer with Action Buttons -->
      <div class="p-3.5 sm:p-4 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/90 flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 shrink-0">
        <button
          id="modal-close-footer-btn"
          type="button"
          class="hidden sm:inline-flex rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-3.5 py-2 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-700 transition-colors cursor-pointer"
          data-i18n="modal.close"
        >
          Cerrar
        </button>

        <div class="flex items-center gap-2 w-full sm:w-auto">
          <a
            id="modal-github-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-3.5 py-2 text-xs font-semibold text-zinc-800 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-700 transition-colors"
          >
            <Github class="h-3.5 w-3.5" />
            <span>GitHub</span>
          </a>

          <a
            id="modal-demo-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 rounded-xl bg-zinc-900 dark:bg-white px-3.5 py-2 text-xs font-semibold text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors shadow-xs"
          >
            <ExternalLink class="h-3.5 w-3.5" />
            <span>Sitio Live</span>
          </a>
        </div>
      </div>

    </div>
  </div>

</section>

<script>
  import { projects } from "../data/projects";
  import { translations, type Lang } from "../data/i18n";

  let activeCategory = "all";
  let searchQuery = "";
  let currentLang: Lang = (document.documentElement.getAttribute("lang") as Lang) || "es";
  let activeProjectId: string | null = null;

  const searchInput = document.getElementById("project-search") as HTMLInputElement;
  const clearSearchBtn = document.getElementById("clear-search-btn") as HTMLButtonElement;
  const filterPills = document.querySelectorAll(".filter-pill");
  const projectCards = document.querySelectorAll(".project-card") as NodeListOf<HTMLElement>;
  const resultsCount = document.getElementById("results-count") as HTMLElement;
  const resetFiltersBtn = document.getElementById("reset-filters") as HTMLButtonElement;
  const emptyResetBtn = document.getElementById("empty-reset-btn") as HTMLButtonElement;
  const noResults = document.getElementById("no-results") as HTMLElement;
  const totalCount = projectCards.length;

  // Modal elements
  const modalBackdrop = document.getElementById("project-modal");
  const modalDialog = document.getElementById("modal-dialog");
  const modalImg = document.getElementById("modal-img") as HTMLImageElement;
  const modalTitle = document.getElementById("modal-title");
  const modalBadge = document.getElementById("modal-badge");
  const modalRole = document.getElementById("modal-role");
  const modalSummary = document.getElementById("modal-summary");
  const modalArchitecture = document.getElementById("modal-architecture");
  const modalFeaturesList = document.getElementById("modal-features-list");
  const modalImpact = document.getElementById("modal-impact");
  const modalTechPills = document.getElementById("modal-tech-pills");
  const modalGithubLink = document.getElementById("modal-github-link") as HTMLAnchorElement;
  const modalDemoLink = document.getElementById("modal-demo-link") as HTMLAnchorElement;
  const modalCloseBtn = document.getElementById("modal-close-btn");
  const modalCloseFooterBtn = document.getElementById("modal-close-footer-btn");

  function openProjectModal(id: string) {
    const project = projects.find((p) => p.id === id);
    if (!project) return;
    activeProjectId = id;

    const details = project.details ? project.details[currentLang] : null;

    if (modalImg) {
      modalImg.src = project.image;
      modalImg.alt = project.title;
    }
    if (modalTitle) modalTitle.textContent = project.title;
    if (modalBadge) modalBadge.textContent = project.badge;
    if (modalRole) modalRole.textContent = project.role;

    if (modalSummary) {
      modalSummary.textContent = details ? details.summary : project.description;
    }
    if (modalArchitecture) {
      modalArchitecture.textContent = details ? details.architecture : project.challenge;
    }

    if (modalFeaturesList) {
      modalFeaturesList.innerHTML = "";
      const features = details?.features || [project.description, project.challenge];
      features.forEach((feat) => {
        const li = document.createElement("li");
        li.className = "flex items-start gap-2";
        li.innerHTML = `<span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span><span>${feat}</span>`;
        modalFeaturesList.appendChild(li);
      });
    }

    if (modalImpact) {
      modalImpact.textContent = details ? details.impact : "Diseñado con estándares de alta ingeniería y código limpio.";
    }

    if (modalTechPills) {
      modalTechPills.innerHTML = "";
      project.tech.forEach((t) => {
        const span = document.createElement("span");
        span.className = "rounded-md border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900 px-2.5 py-1 text-xs font-mono text-zinc-700 dark:text-zinc-300";
        span.textContent = t;
        modalTechPills.appendChild(span);
      });
    }

    if (modalGithubLink) {
      if (project.github) {
        modalGithubLink.href = project.github;
        modalGithubLink.classList.remove("hidden");
      } else {
        modalGithubLink.classList.add("hidden");
      }
    }

    if (modalDemoLink) {
      if (project.demo) {
        modalDemoLink.href = project.demo;
        modalDemoLink.classList.remove("hidden");
      } else {
        modalDemoLink.classList.add("hidden");
      }
    }

    // Show modal with animation
    if (modalBackdrop && modalDialog) {
      modalBackdrop.classList.remove("opacity-0", "pointer-events-none");
      modalBackdrop.setAttribute("aria-hidden", "false");
      modalDialog.classList.remove("scale-95", "translate-y-8");
      modalDialog.classList.add("scale-100", "translate-y-0");
      document.body.style.overflow = "hidden";
    }
  }

  function closeProjectModal() {
    activeProjectId = null;
    if (modalBackdrop && modalDialog) {
      modalBackdrop.classList.add("opacity-0", "pointer-events-none");
      modalBackdrop.setAttribute("aria-hidden", "true");
      modalDialog.classList.remove("scale-100", "translate-y-0");
      modalDialog.classList.add("scale-95", "translate-y-8");
      document.body.style.overflow = "";
    }
  }

  // Attach modal trigger listeners
  document.querySelectorAll(".open-modal-trigger").forEach((el) => {
    el.addEventListener("click", (e) => {
      e.stopPropagation();
      const id = el.getAttribute("data-project-id");
      if (id) openProjectModal(id);
    });
  });

  modalCloseBtn?.addEventListener("click", closeProjectModal);
  modalCloseFooterBtn?.addEventListener("click", closeProjectModal);

  modalBackdrop?.addEventListener("click", (e) => {
    if (e.target === modalBackdrop) {
      closeProjectModal();
    }
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeProjectModal();
  });

  function updateCategoryLabels(lang: Lang) {
    const t = translations[lang].projects.categories;
    document.querySelectorAll(".cat-label").forEach((el) => {
      const catId = el.getAttribute("data-cat-id");
      if (catId && t[catId]) {
        el.textContent = t[catId];
      }
    });
  }

  window.addEventListener("portfolio-lang-change", (e: any) => {
    currentLang = e.detail.lang;
    updateCategoryLabels(currentLang);
    if (activeProjectId) {
      openProjectModal(activeProjectId);
    }
    applyFilters();
  });

  function applyFilters() {
    let visibleCount = 0;
    const q = searchQuery.toLowerCase().trim();

    projectCards.forEach((card) => {
      const cat = card.getAttribute("data-category") || "";
      const isFeatured = card.getAttribute("data-featured") === "true";
      const title = card.getAttribute("data-title") || "";
      const desc = card.getAttribute("data-description") || "";
      const tech = card.getAttribute("data-tech") || "";

      let categoryMatch = false;
      if (activeCategory === "all") {
        categoryMatch = true;
      } else if (activeCategory === "featured") {
        categoryMatch = isFeatured;
      } else if (activeCategory === "tools") {
        categoryMatch = cat === "tools" || cat === "bots";
      } else {
        categoryMatch = cat === activeCategory;
      }

      let searchMatch = true;
      if (q) {
        searchMatch = title.includes(q) || desc.includes(q) || tech.includes(q);
      }

      if (categoryMatch && searchMatch) {
        card.style.display = "flex";
        visibleCount++;
      } else {
        card.style.display = "none";
      }
    });

    if (resultsCount) {
      const t = translations[currentLang].projects;
      resultsCount.textContent = `${t.showing} ${visibleCount} ${t.of} ${totalCount} ${t.projectsCount}`;
    }

    if (visibleCount === 0) {
      noResults?.classList.remove("hidden");
    } else {
      noResults?.classList.add("hidden");
    }

    const isFiltered = activeCategory !== "all" || q.length > 0;
    if (resetFiltersBtn) {
      if (isFiltered) {
        resetFiltersBtn.classList.remove("hidden");
      } else {
        resetFiltersBtn.classList.add("hidden");
      }
    }
  }

  filterPills.forEach((pill) => {
    pill.addEventListener("click", () => {
      filterPills.forEach((p) => {
        p.setAttribute("data-active", "false");
      });
      pill.setAttribute("data-active", "true");
      activeCategory = pill.getAttribute("data-category") || "all";
      applyFilters();
    });
  });

  searchInput?.addEventListener("input", (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    if (searchQuery) {
      clearSearchBtn?.classList.remove("hidden");
    } else {
      clearSearchBtn?.classList.add("hidden");
    }
    applyFilters();
  });

  function resetAll() {
    activeCategory = "all";
    searchQuery = "";
    if (searchInput) searchInput.value = "";
    clearSearchBtn?.classList.add("hidden");

    filterPills.forEach((p) => {
      p.setAttribute("data-active", p.getAttribute("data-category") === "all" ? "true" : "false");
    });
    applyFilters();
  }

  clearSearchBtn?.addEventListener("click", () => {
    searchQuery = "";
    if (searchInput) {
      searchInput.value = "";
      searchInput.focus();
    }
    clearSearchBtn.classList.add("hidden");
    applyFilters();
  });

  resetFiltersBtn?.addEventListener("click", resetAll);
  emptyResetBtn?.addEventListener("click", resetAll);
</script>
