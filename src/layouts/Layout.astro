---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Julián Alconcher | Software Engineer & Developer",
  description = "Portfolio de Julián Alconcher. Software Engineer especializado en desarrollo Full Stack, arquitecturas de software, aplicaciones de sistemas en macOS y soluciones satelitales/AI.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Julián Alconcher" />
    <meta name="keywords" content="Julián Alconcher, Software Engineer, Frontend, Backend, Full Stack, Astro, React, Swift, Python, TypeScript, Portafolio" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://github.com/JulianAlconcher" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&q=80&w=1200" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
      body {
        font-family: "Plus Jakarta Sans", system-ui, sans-serif;
      }
      code, kbd, samp, pre, .font-mono {
        font-family: "JetBrains Mono", monospace;
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#030712] text-gray-100 selection:bg-blue-600/30 selection:text-blue-200">
    <div class="fixed inset-0 glow-mesh pointer-events-none z-0"></div>
    <div class="relative z-10 flex min-h-screen flex-col">
      <Navbar />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
